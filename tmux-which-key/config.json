{
  "items": [
    {
      "key": "p",
      "type": "group",
      "description": "panes",
      "items": [
        { "key": "h", "type": "tmux", "command": "select-pane -L", "description": "Select left pane" },
        { "key": "j", "type": "tmux", "command": "select-pane -D", "description": "Select lower pane" },
        { "key": "k", "type": "tmux", "command": "select-pane -U", "description": "Select upper pane" },
        { "key": "l", "type": "tmux", "command": "select-pane -R", "description": "Select right pane" },
        { "key": "v", "type": "tmux", "command": "split-window -h -c #{pane_current_path}", "description": "Split left/right" },
        { "key": "s", "type": "tmux", "command": "split-window -v -c #{pane_current_path}", "description": "Split top/bottom" },
        { "key": "z", "type": "tmux", "command": "resize-pane -Z", "description": "Zoom toggle" },
        { "key": "x", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh confirm-before -p 'Kill pane? (y/n)' kill-pane", "description": "Kill pane" },
        { "key": "c", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell 'mkdir -p \"$HOME/tmux-captures\"; file=\"$HOME/tmux-captures/tmux-capture-$(date +%Y%m%d-%H%M%S).txt\"; tmux capture-pane -pS - -t \"#{pane_id}\" > \"$file\"; tmux display-message \"Captured pane to $file\"'", "description": "Capture Pane to File" },
        { "key": "y", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh set-window-option synchronize-panes ';' refresh-client -S", "description": "Synchronize Panes" },
        { "key": "C", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh send-keys C-l ';' clear-history", "description": "Clear Scrollback" },
        { "key": "d", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell '~/.config/tmux/scripts/copy-pane-path.sh \"#{pane_id}\"'", "description": "Copy Pane Directory" },
        {
          "key": "m",
          "type": "group",
          "description": "marked panes",
          "items": [
            { "key": "m", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh if-shell -F '#{pane_marked}' 'select-pane -M' 'select-pane -m' ';' refresh-client -S", "description": "Toggle Mark on Current Pane" },
            { "key": "s", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh if-shell -F '#{pane_marked_set}' \"if-shell -F '#{pane_marked}' 'display-message \\\"Current pane is already marked\\\"' 'swap-pane -s {marked} -t #{pane_id}'\" 'display-message \"No marked pane\"' ';' refresh-client -S", "description": "Swap With Marked Pane" },
            { "key": "j", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh if-shell -F '#{pane_marked_set}' \"if-shell -F '#{pane_marked}' 'display-message \\\"Current pane is already marked\\\"' 'join-pane -s {marked} -t #{pane_id}'\" 'display-message \"No marked pane\"' ';' refresh-client -S", "description": "Join Marked Pane Here" },
            { "key": "c", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh select-pane -M ';' refresh-client -S", "description": "Clear Mark" }
          ]
        },
        {
          "key": "L",
          "type": "group",
          "description": "layouts",
          "items": [
            { "key": "t", "type": "tmux", "command": "select-layout tiled", "description": "Tiled" },
            { "key": "h", "type": "tmux", "command": "select-layout even-horizontal", "description": "Even Horizontal" },
            { "key": "v", "type": "tmux", "command": "select-layout even-vertical", "description": "Even Vertical" },
            { "key": "H", "type": "tmux", "command": "select-layout main-horizontal", "description": "Main Horizontal" },
            { "key": "V", "type": "tmux", "command": "select-layout main-vertical", "description": "Main Vertical" },
            { "key": "l", "type": "tmux", "command": "rotate-window -D", "description": "Rotate Clockwise" },
            { "key": "r", "type": "tmux", "command": "rotate-window -U", "description": "Rotate Counterclockwise" }
          ]
        }
      ]
    },
    {
      "key": "w",
      "type": "group",
      "description": "windows",
      "items": [
        { "key": "n", "type": "tmux", "command": "new-window -c #{pane_current_path}", "description": "New window" },
        { "key": "x", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh confirm-before -p 'Kill window? (y/n)' kill-window", "description": "Kill window" },
        { "key": "r", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh command-prompt -I '#W' 'rename-window -- \"%%\"'", "description": "Rename window" },
        { "key": "l", "type": "tmux", "command": "last-window", "description": "Last window" },
        { "key": ".", "type": "tmux", "command": "next-window", "description": "Next window" },
        { "key": "p", "type": "tmux", "command": "previous-window", "description": "Previous window" },
        { "key": "w", "type": "tmux", "command": "choose-tree -w", "description": "Choose window" },
        { "key": "m", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh command-prompt -p 'Move to:' 'move-window -t \"%%\"'", "description": "Move window" },
        { "key": "s", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh command-prompt -p 'Swap with:' 'swap-window -t \"%%\"'", "description": "Swap window" },
        { "key": "R", "type": "tmux", "command": "rotate-window", "description": "Rotate panes" }
      ]
    },
    {
      "key": "s",
      "type": "group",
      "description": "sessions",
      "items": [
        { "key": "n", "type": "tmux", "command": "new-session", "description": "New session" },
        { "key": "d", "type": "tmux", "command": "detach-client", "description": "Detach client" },
        { "key": "s", "type": "tmux", "command": "choose-session", "description": "Choose session" },
        { "key": "w", "type": "tmux", "command": "choose-tree", "description": "Choose tree" },
        { "key": "r", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh command-prompt -I '#S' 'rename-session -- \"%%\"'", "description": "Rename session" },
        { "key": "k", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh confirm-before -p 'Kill session? (y/n)' kill-session", "description": "Kill session" },
        { "key": "l", "type": "tmux", "command": "list-sessions", "description": "List sessions" },
        { "key": "p", "type": "tmux", "command": "switch-client -p", "description": "Previous session" },
        { "key": "N", "type": "tmux", "command": "switch-client -n", "description": "Next session" }
      ]
    },
    {
      "key": "b",
      "type": "group",
      "description": "buffers",
      "items": [
        { "key": "l", "type": "popup", "command": "tmux list-buffers | less", "description": "List buffers" },
        { "key": "p", "type": "tmux", "command": "paste-buffer", "description": "Paste buffer" },
        { "key": "c", "type": "tmux", "command": "choose-buffer", "description": "Choose buffer" },
        { "key": "d", "type": "tmux", "command": "delete-buffer", "description": "Delete buffer" },
        { "key": "v", "type": "popup", "command": "tmux show-buffer | less", "description": "Show buffer" },
        { "key": "y", "type": "tmux", "command": "copy-mode", "description": "Copy mode" }
      ]
    },
    {
      "key": "c",
      "type": "group",
      "description": "clients",
      "items": [
        { "key": "s", "type": "popup", "command": "~/.config/tmux/scripts/show-clients.sh", "description": "Show Attached Clients" },
        { "key": "d", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh confirm-before -p 'Detach all other clients? (y/n)' 'detach-client -a'", "description": "Detach Other Clients" },
        { "key": "c", "type": "tmux", "command": "choose-client", "description": "Choose client" },
        { "key": "r", "type": "tmux", "command": "refresh-client", "description": "Refresh client" }
      ]
    },
    {
      "key": "g",
      "type": "group",
      "description": "git",
      "items": [
        { "key": "g", "type": "popup", "command": "lazygit", "description": "Lazygit Popup" },
        { "key": "o", "type": "popup", "command": "~/.config/tmux/scripts/tmux-which-key-popup.sh repository-overview", "description": "Repository Overview" }
      ]
    },
    {
      "key": "a",
      "type": "group",
      "description": "AI",
      "items": [
        { "key": "a", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell '~/.config/tmux/scripts/ai-prompt.sh ask \"#{pane_id}\"'", "description": "AI: Ask" },
        { "key": "d", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell '~/.config/tmux/scripts/ai-prompt.sh error \"#{pane_id}\"'", "description": "AI: Diagnose Error" },
        { "key": "f", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell '~/.config/tmux/scripts/ai-prompt.sh fix \"#{pane_id}\"'", "description": "AI: Suggest Fix" },
        { "key": "s", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell '~/.config/tmux/scripts/ai-prompt.sh summarize \"#{pane_id}\"'", "description": "AI: Summarize Pane" },
        { "key": "c", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell '~/.config/tmux/scripts/ai-prompt.sh command \"#{pane_id}\"'", "description": "AI: Generate Command" },
        { "key": "e", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell '~/.config/tmux/scripts/ai-prompt.sh explain \"#{pane_id}\"'", "description": "AI: Explain" },
        { "key": "y", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell '~/.config/tmux/scripts/ai-prompt.sh explain-copy \"#{pane_id}\"'", "description": "AI: Explain Last Copy" }
      ]
    },
    {
      "key": "t",
      "type": "group",
      "description": "tools",
      "items": [
        { "key": "s", "type": "popup", "command": "tmux-snaglord", "description": "Snaglord" },
        {
          "key": "f",
          "type": "group",
          "description": "file picker",
          "items": [
            { "key": "f", "type": "popup", "command": "~/.config/tmux/scripts/tmux-file-picker", "description": "Files in Current Directory" },
            { "key": "d", "type": "popup", "command": "~/.config/tmux/scripts/tmux-file-picker --directories", "description": "Directories in Current Directory" },
            { "key": "r", "type": "popup", "command": "~/.config/tmux/scripts/tmux-file-picker --zoxide", "description": "Files from Recent Directory" },
            { "key": "R", "type": "popup", "command": "~/.config/tmux/scripts/tmux-file-picker --zoxide --dir-only", "description": "Recent Directories" }
          ]
        },
        { "key": "m", "type": "popup", "command": "btop", "description": "System Monitor" },
        { "key": "M", "type": "tmux", "command": "show-messages", "description": "Show Messages" },
        { "key": "t", "type": "popup", "command": "tmux new-session -A -s Scratch-Terminal", "description": "Scratch Popup" }
      ]
    },
    {
      "key": "P",
      "type": "group",
      "description": "plugins",
      "items": [
        {
          "key": "f",
          "type": "group",
          "description": "tmux-fzf",
          "items": [
            { "key": "f", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell -b ~/.config/tmux/plugins/tmux-fzf/main.sh", "description": "tmux-fzf Full Menu" },
            { "key": "s", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell -b ~/.config/tmux/plugins/tmux-fzf/scripts/session.sh", "description": "Sessions" },
            { "key": "w", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell -b ~/.config/tmux/plugins/tmux-fzf/scripts/window.sh", "description": "Windows" },
            { "key": "p", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell -b ~/.config/tmux/plugins/tmux-fzf/scripts/pane.sh", "description": "Panes" },
            { "key": "k", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell -b ~/.config/tmux/plugins/tmux-fzf/scripts/keybinding.sh", "description": "Key Bindings" },
            { "key": "c", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell -b ~/.config/tmux/plugins/tmux-fzf/scripts/command.sh", "description": "Commands" },
            { "key": "b", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell -b ~/.config/tmux/plugins/tmux-fzf/scripts/clipboard.sh", "description": "Clipboard" },
            { "key": "x", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell -b ~/.config/tmux/plugins/tmux-fzf/scripts/process.sh", "description": "Processes" }
          ]
        },
        {
          "key": "e",
          "type": "group",
          "description": "Extrakto",
          "items": [
            { "key": "t", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell '~/.config/tmux/plugins/extrakto/scripts/open.sh \"#{pane_id}\"'", "description": "Extract Text" },
            { "key": "w", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell '~/.config/tmux/plugins/extrakto/scripts/open.sh \"#{pane_id}\" word'", "description": "Extract Words" },
            { "key": "l", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell '~/.config/tmux/plugins/extrakto/scripts/open.sh \"#{pane_id}\" line'", "description": "Extract Lines" },
            { "key": "p", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell '~/.config/tmux/plugins/extrakto/scripts/open.sh \"#{pane_id}\" path'", "description": "Extract Paths" },
            { "key": "u", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell '~/.config/tmux/plugins/extrakto/scripts/open.sh \"#{pane_id}\" url'", "description": "Extract URLs" },
            { "key": "h", "type": "popup", "command": "~/.config/tmux/scripts/tmux-which-key-popup.sh extrakto-help", "description": "Extrakto Help" }
          ]
        },
        {
          "key": "t",
          "type": "group",
          "description": "TPM",
          "items": [
            { "key": "i", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell ~/.config/tmux/plugins/tpm/bindings/install_plugins", "description": "Install Plugins" },
            { "key": "u", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell ~/.config/tmux/plugins/tpm/bindings/update_plugins", "description": "Update Plugins" },
            { "key": "c", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell ~/.config/tmux/plugins/tpm/bindings/clean_plugins", "description": "Clean Plugins" }
          ]
        },
        {
          "key": "k",
          "type": "group",
          "description": "Cowboy",
          "items": [
            { "key": "t", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh confirm-before -p 'SIGTERM process in current pane? (y/n)' \"run-shell '~/.config/tmux/plugins/tmux-cowboy/scripts/kill.sh TERM'\"", "description": "Terminate Current Pane Process" },
            { "key": "k", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh confirm-before -p 'SIGKILL process in current pane? (y/n)' \"run-shell '~/.config/tmux/plugins/tmux-cowboy/scripts/kill.sh KILL'\"", "description": "Kill Current Pane Process" }
          ]
        },
        {
          "key": "s",
          "type": "group",
          "description": "Sensible",
          "items": [
            { "key": "r", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh source-file ~/.tmux.conf ';' display-message 'Config reloaded'", "description": "Reload tmux Config" },
            { "key": "o", "type": "popup", "command": "~/.config/tmux/scripts/tmux-which-key-popup.sh effective-options", "description": "Show Effective Options" }
          ]
        },
        {
          "key": "r",
          "type": "group",
          "description": "Resurrect",
          "items": [
            { "key": "s", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell ~/.config/tmux/plugins/tmux-resurrect/scripts/save.sh", "description": "Save tmux State" },
            { "key": "r", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell ~/.config/tmux/plugins/tmux-resurrect/scripts/restore.sh", "description": "Restore tmux State" },
            { "key": "l", "type": "popup", "command": "~/.config/tmux/scripts/tmux-which-key-popup.sh resurrect-files", "description": "List Saved States" },
            { "key": "L", "type": "popup", "command": "~/.config/tmux/scripts/tmux-which-key-popup.sh resurrect-latest", "description": "Show Latest Save" },
            { "key": "o", "type": "popup", "command": "~/.config/tmux/scripts/tmux-which-key-popup.sh resurrect-options", "description": "Show Resurrect Options" }
          ]
        },
        {
          "key": "c",
          "type": "group",
          "description": "Continuum",
          "items": [
            { "key": "s", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell ~/.config/tmux/plugins/tmux-continuum/scripts/continuum_save.sh", "description": "Run Continuum Save" },
            { "key": "r", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh run-shell ~/.config/tmux/plugins/tmux-continuum/scripts/continuum_restore.sh", "description": "Run Continuum Restore" },
            { "key": "S", "type": "popup", "command": "~/.config/tmux/scripts/tmux-which-key-popup.sh continuum-status", "description": "Show Continuum Status" },
            { "key": "o", "type": "popup", "command": "~/.config/tmux/scripts/tmux-which-key-popup.sh continuum-options", "description": "Show Continuum Options" },
            { "key": "l", "type": "popup", "command": "~/.config/tmux/scripts/tmux-which-key-popup.sh continuum-files", "description": "List Autosave Files" }
          ]
        }
      ]
    },
    {
      "key": "o",
      "type": "group",
      "description": "options",
      "items": [
        { "key": "g", "type": "popup", "command": "tmux show-options -g | less", "description": "Show global options" },
        { "key": "w", "type": "popup", "command": "tmux show-window-options -g | less", "description": "Show window options" },
        { "key": "e", "type": "popup", "command": "tmux show-environment -g | less", "description": "Show environment" },
        { "key": "c", "type": "tmux", "command": "customize-mode -Z", "description": "Customize mode" }
      ]
    },
    { "key": "r", "type": "script", "command": "~/.config/tmux/scripts/defer-tmux-command.sh source-file ~/.tmux.conf ';' display-message 'Config reloaded'", "description": "Reload config" },
    { "key": ":", "type": "tmux", "command": "command-prompt", "description": "Command prompt" },
    { "key": "?", "type": "popup", "command": "tmux list-keys -T prefix -N | less", "description": "Live prefix key help" }
  ]
}
